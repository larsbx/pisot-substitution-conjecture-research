  "matrix_conventions": {
    "deficit": "e_j = theta*h_j - sum_i T[i,j]*h_i",
    "edge": "i -> j iff T[i,j] > 0; row i is an inverse parent and column j an inverse child",
    "ell": "(1,beta/2,(beta^2-beta-2)/2), beta the positive Perron root of x^3-x^2-3*x-2",
    "entry": "T[i,j] is the number of retained literal occurrence pairs from state i to state j, including repetitions",
    "mass": "h_i = length([0,ell_a] intersect [-ell*z,ell_b-ell*z]) for state (a,b,z)",
    "mixed_orbit_rule": "m_i*T[i,j] = m_j*F[j,i]; use H_i=m_i*h_i so T^T H <= theta H",
    "theta": "beta^2",
    "track_swap": "(a,b,z) -> (b,a,-z); every retained orbit has size two in this source class"
  },
