@origin_inflateH : ∀ {α : Type u_1} [Fintype α] [DecidableEq α] [inst : Nonempty α]
  {S : Psc.PeriodicPartnerHull.LengthSubst α} (U : S.Hull),
  origin (Psc.PeriodicPartnerHull.LengthSubst.inflateH U) = originChild S (origin U)
@originChild_periodic_of_periodic : ∀ {α : Type u_1} [Fintype α] [DecidableEq α] [inst : Nonempty α]
  {S : Psc.PeriodicPartnerHull.LengthSubst α} {U : S.Hull} {n : ℕ},
  Psc.PeriodicPartnerHull.LengthSubst.inflateH^[n] U = U → (originChild S)^[n] (origin U) = origin U
PeriodicLatticeOriginsClassified : (k : ℕ) → 1 ≤ k → Prop
anchor_common_tile_of_origin_vertex : ∀ (k : ℕ) (hk : 1 ≤ k),
  2 ≤ k →
    ∀ {V U : (Psc.ParameterFamilyTiling.geometry k hk).Hull},
      (1, 0) ∈ ↑V →
        Psc.PeriodicPartnerHull.LengthSubst.inflateH^[2] V = V →
          realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ V = 0 →
            realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ U = 0 →
              ∀ {a : Fin 3}, (a, 0) ∈ ↑U → (↑V ∩ ↑U).Nonempty
anchor_common_tile_of_interior_phase : ∀ (k : ℕ) (hk : 1 ≤ k),
  2 ≤ k →
    ∀ {V U : (Psc.ParameterFamilyTiling.geometry k hk).Hull},
      (1, 0) ∈ ↑V →
        Psc.PeriodicPartnerHull.LengthSubst.inflateH^[2] V = V →
          realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ V = 0 →
            realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ U = 0 →
              origin U = (1, -(Psc.ParameterFamilyTiling.geometry k hk).ℓ 0) ∨
                  origin U =
                      (1,
                        (Psc.ParameterFamilyTiling.geometry k hk).ℓ 0 - (Psc.ParameterFamilyTiling.geometry k hk).ℓ 1) ∨
                    origin U = (1, -(Psc.ParameterFamilyTiling.geometry k hk).ℓ 2) →
                (↑V ∩ ↑U).Nonempty
anchor_common_tile_of_classified : ∀ (k : ℕ) (hk : 1 ≤ k),
  2 ≤ k →
    PeriodicLatticeOriginsClassified k hk →
      ∀ {V U : (Psc.ParameterFamilyTiling.geometry k hk).Hull},
        (1, 0) ∈ ↑V →
          Psc.PeriodicPartnerHull.LengthSubst.inflateH^[2] V = V →
            realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ V = 0 →
              realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ U = 0 → (↑V ∩ ↑U).Nonempty
all_pair_witnesses_of_classified : ∀ (k : ℕ) (hk : 1 ≤ k),
  2 ≤ k →
    PeriodicLatticeOriginsClassified k hk →
      ∀ (T U : (Psc.ParameterFamilyTiling.geometry k hk).Hull),
        realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ T = 0 →
          realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ U = 0 →
            Psc.PeriodicPartnerProximal.WindowWitnesses (Psc.ParameterFamilyTiling.geometry k hk) 1 T U
zero_fibre_exactProximal_of_classified : ∀ (k : ℕ) (hk : 1 ≤ k),
  2 ≤ k →
    PeriodicLatticeOriginsClassified k hk →
      ∀ (T U : (Psc.ParameterFamilyTiling.geometry k hk).Hull),
        realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ T = 0 →
          realize (Psc.ParameterFamilySolenoid.pisotData k hk) ⋯ U = 0 →
            Psc.PeriodicPartnerProximal.ExactProximal (Psc.ParameterFamilyTiling.geometry k hk) T U
