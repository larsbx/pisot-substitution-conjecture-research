@originChild_eq : ∀ {α : Type u_1} {S : Psc.PeriodicPartnerHull.LengthSubst α} {q p : α × ℝ},
  p ∈ S.place (S.σ q.1) (S.β * q.2) → 0 ∈ S.supp p → originChild S q = p
vertex_tile_periodic : ∀ (k : ℕ) (hk : 1 ≤ k),
  (originChild (Psc.ParameterFamilyTiling.geometry k hk))^[2] (1, 0) = (1, 0)
interior_phase_periodic : ∀ (k : ℕ) (hk : 1 ≤ k),
  2 ≤ k →
    (originChild (Psc.ParameterFamilyTiling.geometry k hk))^[3] (1, -(Psc.ParameterFamilyTiling.geometry k hk).ℓ 0) =
        (1, -(Psc.ParameterFamilyTiling.geometry k hk).ℓ 0) ∧
      -(Psc.ParameterFamilyTiling.geometry k hk).ℓ 0 < 0 ∧
        0 < -(Psc.ParameterFamilyTiling.geometry k hk).ℓ 0 + (Psc.ParameterFamilyTiling.geometry k hk).ℓ 1 ∧
          ∃ v ∈ lattice (Fin 3),
            -(Psc.ParameterFamilyTiling.geometry k hk).ℓ 0 = -((Psc.ParameterFamilyTiling.geometry k hk).ℓ ⬝ᵥ v)
