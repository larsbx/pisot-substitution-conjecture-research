def rows_plus(kind: Int, j: Int) raises -> List[List[Int]]:
    """Rows of the regime `(kind, j)` of this sign; an unfitted regime raises."""
    if kind == 0 and j == 0:
        return rows_low0()
    if kind == 0 and j == 1:
        return rows_low1()
    if kind == 0 and j == 2:
        return rows_low2()
    if kind == 0 and j == 3:
        return rows_low3()
    if kind == 0 and j == 4:
        return rows_low4()
    if kind == 1 and j == 1:
        return rows_high1()
    if kind == 1 and j == 2:
        return rows_high2()
    if kind == 1 and j == 3:
        return rows_high3()
    if kind == 1 and j == 4:
        return rows_high4()
    if kind == 1 and j == 5:
        return rows_high5()
    if kind == 2 and j == 5:
        return rows_middle()
    raise Error("no fitted regime rows for kind " + String(kind) + " j " + String(j))
