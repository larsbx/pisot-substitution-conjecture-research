"""Literal path proposals. The canonical verifier proves every row on its entire integer chamber; no interpolation is accepted as evidence."""
from psc.class_a_boundary_children import BoundaryLabel

def recipe_sources(family: Int) raises -> List[BoundaryLabel]:
    if family==0:
        return [BoundaryLabel(1,0,0,0,-2), BoundaryLabel(1,2,1,0,-2), BoundaryLabel(2,1,1,-1,-2), BoundaryLabel(2,1,1,-1,-1), BoundaryLabel(2,2,1,-1,-2), BoundaryLabel(2,2,1,-1,-1)]
    elif family==1:
        return [BoundaryLabel(0,1,1,0,-3), BoundaryLabel(0,2,1,1,-3), BoundaryLabel(0,2,1,1,-2), BoundaryLabel(2,1,1,0,-2)]
    elif family==2:
        return [BoundaryLabel(0,2,1,-1,-2), BoundaryLabel(0,2,1,-1,-1), BoundaryLabel(0,2,1,-1,0), BoundaryLabel(0,2,1,-1,1), BoundaryLabel(2,0,0,-1,-1), BoundaryLabel(2,0,0,-1,0), BoundaryLabel(2,0,0,-1,1), BoundaryLabel(2,0,0,-1,2), BoundaryLabel(2,2,1,-1,-2), BoundaryLabel(2,2,1,-1,-1)]
    raise Error("unknown selected-exit family")

