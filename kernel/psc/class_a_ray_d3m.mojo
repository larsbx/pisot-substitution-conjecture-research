def pieces_r0() -> List[List[Int]]:
    """Ray r=0, fitted to exports n=12..33; X = a l + b j + c (rows 88: depth <= floor(X/3) <= depth+1). [carrier row, j_lo l-slope, j_lo constant, j_hi l-slope, j_hi constant, X_l, X_j, X_c]."""
    return List[List[Int]]([
        List[Int]([0,0,0,0,1,0,-2,8]),
        List[Int]([1,0,0,0,1,0,-3,9]),
        List[Int]([2,0,0,0,0,2,-3,3]),
