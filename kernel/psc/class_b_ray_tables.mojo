def _parse(text: String, width: Int) raises -> List[List[Int]]:
    var out = List[List[Int]]()
    var row = List[Int]()
    for tok in text.split(" "):
        row.append(Int(String(tok)))
        if len(row) == width:
            out.append(row^)
            row = List[Int]()
    if len(row) != 0:
        raise Error("class-B ray table is not a whole number of rows")
    return out^


