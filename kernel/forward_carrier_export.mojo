"""Export the two literal named forward carriers or their Lean state lists.

Usage: forward-carrier-export FIXTURE [STATE_CAP LENGTH_CAP] [--lean]
FIXTURE is 0 (1/021/001) or 1 (1/012/001). Budgets count normalized states
and maximum state length. Exhaustion refuses a certificate, never proves
infinitude. Native JSON rows and Lean states-only checking are distinct.
"""

from std.sys import argv
from psc.c4_finite_cylinder_overlap import fixture_images
from psc.forward_carrier import ForwardCarrier, build_forward_carrier, normalized_count, longest_state


def ints(values: List[Int]) -> String:
    var text = String("[")
    for i in range(len(values)):
        if i > 0:
            text += ","
        text += String(values[i])
    return text + "]"


def positive(text: String) raises -> Int:
    if text.byte_length() == 0 or text.byte_length() > 8:
        raise Error("budget must have 1..8 decimal digits")
    for ch in text.codepoint_slices():
        var digit = String(ch)
        if digit < "0" or digit > "9":
            raise Error("budget must be a positive decimal integer")
    var value = atol(text)
    if value <= 0:
        raise Error("budget must be positive")
    return value


def emit_json(fixture: Int, state_cap: Int, length_cap: Int, carrier: ForwardCarrier) raises:
    var images = fixture_images(fixture)
    print('{"schema":"psc-forward-carrier-v1","fixture":' + String(fixture)
          + ',"substitution":[' + ints(images[0]) + ',' + ints(images[1]) + ',' + ints(images[2]) + ']'
          + ',"state_cap":' + String(state_cap) + ',"length_cap":' + String(length_cap)
          + ',"complete":true,"normalized_state_count":' + String(normalized_count(carrier))
          + ',"state_count":' + String(len(carrier.states))
          + ',"max_state_length":' + String(longest_state(carrier)) + ',"states":[')
    for i in range(len(carrier.states)):
        var prefix = String("") if i == 0 else String(",")
        print(prefix + '{"top":' + ints(carrier.states[i].u)
              + ',"bottom":' + ints(carrier.states[i].v)
              + ',"children":' + ints(carrier.rows[i]) + '}')
    print("]}")


def digits(values: List[Int]) -> String:
    var text = String("")
    for i in range(len(values)):
        text += String(values[i])
    return text


def fin_index(value: Int) -> String:
    # Explicit bounds proofs refuse out-of-range literals instead of using
    # Fin's modular numeral interpretation.
    return "⟨" + String(value) + ", by decide⟩"


def emit_lean(fixture: Int, carrier: ForwardCarrier) raises:
    var name = String("fixture") + String(fixture)
    var count = len(carrier.states)
    var images = fixture_images(fixture)
    print("import PscVerif.FastForwardCarrier")
    print("\n-- Generated by forward_carrier_export.mojo from the canonical bounded BPA.")
    print("-- String decoding rejects invalid digits; kernel checks are split into ranges.")
    print("-- Actual red equality follows from proved streaming/row refinement.")
    print("namespace Psc.GeneratedForwardCarrier\n")
    print("set_option maxRecDepth 200000")
    print("set_option maxHeartbeats 0\n")
    print("def " + name + "Substitution : Fin 3 → List (Fin 3) := !["
          + ints(images[0]) + "," + ints(images[1]) + "," + ints(images[2]) + "]\n")
    for i in range(count):
        print("def " + name + "State" + String(i) + " : List (Fin 3) × List (Fin 3) :=")
        print('  (Psc.FastForwardCarrier.word "' + digits(carrier.states[i].u)
              + '", Psc.FastForwardCarrier.word "' + digits(carrier.states[i].v) + '")')
    print("\ndef " + name + "StateArray : Array (List (Fin 3) × List (Fin 3)) := #[")
    for i in range(count):
        print(("  " if i == 0 else "  ,") + name + "State" + String(i))
    print("]\n")
    print("def " + name + "State (i : Fin " + String(count) + ") : List (Fin 3) × List (Fin 3) :=")
    print("  " + name + "StateArray[i.val]'(by simpa [" + name + "StateArray] using i.isLt)\n")
    print("def " + name + "RowsArray : Array (List (Fin " + String(count) + ")) := #[")
    for i in range(count):
        var row = String("  [") if i == 0 else String("  ,[")
        for j in range(len(carrier.rows[i])):
            if j > 0:
                row += ","
            row += fin_index(carrier.rows[i][j])
        print(row + "]")
    print("]\n")
    print("def " + name + "Rows (i : Fin " + String(count) + ") : List (Fin " + String(count) + ") :=")
    print("  " + name + "RowsArray[i.val]'(by simpa [" + name + "RowsArray] using i.isLt)\n")
    print("def " + name + "Seed (a b : Fin 3) : Fin " + String(count) + " :=")
    print("  match a.val, b.val with")
    for a in range(3):
        for b in range(3):
            if a == b:
                continue
            var found = -1
            var top: List[Int] = [a, b]
            var bottom: List[Int] = [b, a]
            for i in range(count):
                if carrier.states[i].u == top and carrier.states[i].v == bottom:
                    found = i
                    break
            if found < 0:
                raise Error("Lean exporter lost an actual ordered seed")
            print("  | " + String(a) + ", " + String(b) + " => " + fin_index(found))
    print("  | _, _ => " + fin_index(0) + "\n")
    print("def " + name + "Packet : Psc.FastForwardCarrier.Packet " + String(count) + " where")
    print("  state := " + name + "State")
    print("  rows := " + name + "Rows")
    print("  seed := " + name + "Seed\n")
    print("theorem " + name + "Seeds : " + name + "Packet.SeedsValid := by decide +kernel\n")
    var chunk = 8
    var start = 0
    while start < count:
        var size = min(chunk, count - start)
        print("theorem " + name + "Range" + String(start) + " :")
        print("    " + name + "Packet.checkRange " + name + "Substitution " + String(start) + " " + String(size) + " = true := by decide +kernel\n")
        start += size
    print("theorem " + name + "AllRows :")
    print("    " + name + "Packet.checkRange " + name + "Substitution 0 " + String(count) + " = true := by")
    var reached = min(chunk, count)
    print("  have h0 := " + name + "Range0")
    var step = 0
    while reached < count:
        var size = min(chunk, count - reached)
        print("  have h" + String(step + 1) + " := " + name + "Packet.checkRange_append " + name
              + "Substitution 0 " + String(reached) + " " + String(size)
              + " h" + String(step) + " " + name + "Range" + String(reached))
        reached += size
        step += 1
    print("  exact h" + String(step) + "\n")
    print("theorem " + name + "Valid : " + name + "Packet.Valid " + name + "Substitution :=")
    print("  " + name + "Packet.valid_of_range " + name + "Substitution " + name + "Seeds " + name + "AllRows\n")
    print("def " + name + "States : List (List (Fin 3) × List (Fin 3)) := List.ofFn " + name + "Packet.state\n")
    print("theorem " + name + "ForwardCheck :")
    print("    Psc.ForwardCarrier.check " + name + "Substitution " + name + "States = true :=")
    print("  " + name + "Packet.forward_check " + name + "Substitution " + name + "Valid\n")
    print("theorem " + name + "Finite :")
    print("    (Psc.Descendants.bpaStatesNC " + name + "Substitution).Finite :=")
    print("  " + name + "Packet.finite_bpaStatesNC " + name + "Substitution " + name + "Valid\n")
    print("end Psc.GeneratedForwardCarrier")


def main() raises:
    var args = argv()
    if len(args) < 2 or len(args) > 5:
        raise Error("usage: forward-carrier-export FIXTURE [STATE_CAP LENGTH_CAP] [--lean]")
    if args[1] != "0" and args[1] != "1":
        raise Error("fixture must be 0 or 1")
    var fixture = atol(args[1])
    var state_cap = 20000
    var length_cap = 10000
    var lean = args[len(args) - 1] == "--lean"
    var value_count = len(args) - (1 if lean else 0)
    if value_count == 4:
        state_cap = positive(args[2])
        length_cap = positive(args[3])
    elif value_count != 2:
        raise Error("supply both state and length budgets")
    var carrier = build_forward_carrier(fixture_images(fixture), state_cap, length_cap)
    if lean:
        emit_lean(fixture, carrier)
    else:
        emit_json(fixture, state_cap, length_cap, carrier)
