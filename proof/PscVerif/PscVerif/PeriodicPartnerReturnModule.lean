import PscVerif.PeriodicPartnerLegalCoincidence
import PscVerif.PeriodicPartnerRealization

/-!
# The coincidence shifts of a hull tiling form a group containing its return vectors

Assume the legal-patch conclusion: two hull tilings sharing a tile are
densely eventually coincident. For a hull tiling `T`, the translations `w`
for which `T` and `T - w` are densely eventually coincident then form an
additive subgroup of `ℝ`. It contains every return vector of `T`, and
inflation multiplies it by the expansion. When it contains every tile
length, two hull tilings whose tile starts differ by an element of the
group generated by the tile lengths are densely eventually coincident.

This is the return-vector form of the overlap-coincidence argument; no
maximal-equicontinuous-factor identification and no Meyer exactification is
used. Source decision: `docs/c4-zero-fibre-return-group-stop-go-2026-11-21.md`.
-/

namespace Psc.PeriodicPartnerReturnModule

open Function Set Matrix Psc.PeriodicPartnerHull Psc.PeriodicPartnerHull.LengthSubst
open Psc.PeriodicPartnerEventualCoincidence
open Psc.PeriodicPartnerRealization (lattice)

variable {α : Type*} (S : LengthSubst α)

/-- Dense eventual coincidence is transitive through a tiling: both
coincidence sets are open, so their dense intersection lies in the third. -/
theorem dense_eventual_trans [Nonempty α] {P Q R : Set (α × ℝ)} (hQ : S.IsTiling Q)
    (h₁ : Dense (eventual S P Q)) (h₂ : Dense (eventual S Q R)) : Dense (eventual S P R) :=
  (h₁.inter_of_isOpen_left h₂ (eventual_open S _ _)).mono
    fun _ hx => eventual_trans S hQ hx.1 hx.2

/-- The group generated by the tile lengths. -/
def lengthGroup : AddSubgroup ℝ := AddSubgroup.closure (range S.ℓ)

theorem length_mem_lengthGroup (a : α) : S.ℓ a ∈ lengthGroup S :=
  AddSubgroup.subset_closure ⟨a, rfl⟩

theorem sum_mem_lengthGroup (w : List α) : (w.map S.ℓ).sum ∈ lengthGroup S :=
  AddSubgroup.list_sum_mem _ fun x hx => by
    obtain ⟨a, _, rfl⟩ := List.mem_map.mp hx
    exact length_mem_lengthGroup S a

/-- Integer combinations of the tile lengths lie in the length group. -/
theorem dot_mem_lengthGroup [Fintype α] {v : α → ℝ} (hv : v ∈ lattice α) :
    S.ℓ ⬝ᵥ v ∈ lengthGroup S := by
  refine sum_mem fun a _ => ?_
  obtain ⟨n, hn⟩ := hv a
  rw [← hn, mul_comm, ← zsmul_eq_mul]
  exact zsmul_mem (length_mem_lengthGroup S a) n

/-- A placed tile starts at the base point plus lengths of earlier tiles. -/
theorem place_start_mem_lengthGroup {w : List α} {y : ℝ} {q : α × ℝ}
    (hq : q ∈ S.place w y) : q.2 - y ∈ lengthGroup S := by
  induction w generalizing y with
  | nil => simp [LengthSubst.place] at hq
  | cons a w ih =>
    simp only [LengthSubst.place, List.mem_cons] at hq
    rcases hq with rfl | hq
    · simp
    · have h := add_mem (ih hq) (length_mem_lengthGroup S a)
      rwa [show q.2 - (y + S.ℓ a) + S.ℓ a = q.2 - y by ring] at h

/-- Two tile starts of one legal tiling differ by an element of the length
group: a bounded window containing both is a translate of a supertile patch. -/
theorem start_sub_mem_lengthGroup (T : S.Hull) {p q : α × ℝ} (hp : p ∈ T.1) (hq : q ∈ T.1) :
    q.2 - p.2 ∈ lengthGroup S := by
  let r := max |p.2| |q.2| + 1
  obtain ⟨a, n, t, h⟩ := T.2.2 r
  have hmeet (u : α × ℝ) (hu : |u.2| < r) : (S.supp u ∩ Ioo (-r) r).Nonempty :=
    ⟨u.2, ⟨le_rfl, by linarith [S.ℓ_pos u.1]⟩, abs_lt.mp hu⟩
  have hpr : |p.2| < r := lt_of_le_of_lt (le_max_left _ _) (lt_add_one _)
  have hqr : |q.2| < r := lt_of_le_of_lt (le_max_right _ _) (lt_add_one _)
  have hp' := h p hp (hmeet p hpr)
  have hq' := h q hq (hmeet q hqr)
  rw [S.supertile_eq_place] at hp' hq'
  have hu := place_start_mem_lengthGroup S hp'
  have hv := place_start_mem_lengthGroup S hq'
  have he : q.2 - p.2 = (q.2 + t - 0) - (p.2 + t - 0) := by ring
  rw [he]
  exact sub_mem hv hu

variable {S}
variable (hd : ∀ {T U : S.Hull}, (T.1 ∩ U.1).Nonempty → Dense (eventual S T.1 U.1))

/-- The translations by which a hull tiling is densely eventually
coincident with itself. The hypothesis is the legal-patch theorem. -/
def coincidenceShifts [Nonempty α] (T : S.Hull) : AddSubgroup ℝ where
  carrier := {w | Dense (eventual S T.1 (shift w T.1))}
  zero_mem' := by
    change Dense (eventual S T.1 (shift 0 T.1))
    rw [shift_zero]
    obtain ⟨q, hq, _⟩ := (T.2.1 0).exists
    exact hd (T := T) (U := T) ⟨q, hq, hq⟩
  add_mem' := by
    intro a b ha hb
    change Dense (eventual S T.1 (shift (a + b) T.1))
    have hb' : Dense (eventual S (shift a T.1) (shift (a + b) T.1)) := by
      simpa only [shift_shift] using dense_shift S hb a
    exact dense_eventual_trans S (S.isTiling_shift T.2.1 a) ha hb'
  neg_mem' := by
    intro a ha
    change Dense (eventual S T.1 (shift (-a) T.1))
    have h := dense_shift S (P := shift a T.1) (Q := T.1)
      (by rwa [eventual_symm S (shift a T.1) T.1]) (-a)
    simpa only [shift_shift, neg_add_cancel, shift_zero] using h

theorem mem_coincidenceShifts [Nonempty α] {T : S.Hull} {w : ℝ} :
    w ∈ coincidenceShifts hd T ↔ Dense (eventual S T.1 (shift w T.1)) := Iff.rfl

/-- A return vector, the displacement between two tiles of one type, is a
coincidence shift. -/
theorem return_mem [Nonempty α] {T : S.Hull} {a : α} {x y : ℝ}
    (hx : (a, x) ∈ T.1) (hy : (a, y) ∈ T.1) : y - x ∈ coincidenceShifts hd T := by
  refine hd (T := T) (U := translate (y - x) T) ⟨(a, x), hx, ?_⟩
  change (a, x + (y - x)) ∈ T.1
  rwa [add_sub_cancel]

/-- The same statement for two tiles of one type in a translated patch. -/
theorem return_mem_of_patch [Nonempty α] {T : S.Hull} {X : Set (α × ℝ)} {s : ℝ}
    (hX : shift s X ⊆ T.1) {a : α} {x y : ℝ} (hx : (a, x) ∈ X) (hy : (a, y) ∈ X) :
    y - x ∈ coincidenceShifts hd T := by
  have hx' : (a, x - s) ∈ T.1 := hX (by change (a, x - s + s) ∈ X; rwa [sub_add_cancel])
  have hy' : (a, y - s) ∈ T.1 := hX (by change (a, y - s + s) ∈ X; rwa [sub_add_cancel])
  simpa only [sub_sub_sub_cancel_right] using return_mem hd hx' hy'

/-- Inflation multiplies coincidence shifts by the expansion. -/
theorem inflate_mem [Nonempty α] {T : S.Hull} {w : ℝ} (hw : w ∈ coincidenceShifts hd T) :
    S.β * w ∈ coincidenceShifts hd (inflateH T) := by
  have h := dense_inflate_iterate S hw 1
  simp only [iterate_one] at h
  change Dense (eventual S (S.inflate T.1) (shift (S.β * w) (S.inflate T.1)))
  rwa [← S.inflate_shift]

/-- A tiling sharing a tile with a coincidence translate is densely
eventually coincident with the original. -/
theorem dense_eventual_of_shift_mem [Nonempty α] {T U : S.Hull} {a : α} {x y : ℝ}
    (hx : (a, x) ∈ T.1) (hy : (a, y) ∈ U.1) (h : x - y ∈ coincidenceShifts hd T) :
    Dense (eventual S T.1 U.1) := by
  have hy' : (a, y) ∈ shift (x - y) T.1 := by
    change (a, y + (x - y)) ∈ T.1
    rwa [add_sub_cancel]
  have h₂ : Dense (eventual S (shift (x - y) T.1) U.1) :=
    hd (T := translate (x - y) T) (U := U) ⟨(a, y), hy', hy⟩
  exact dense_eventual_trans S (S.isTiling_shift T.2.1 (x - y)) h h₂

/-- If every tile length is a coincidence shift, tilings with tile starts
in one coset of the length group are densely eventually coincident. The
two tiles used for the comparison must have the same type; their positions
are otherwise arbitrary. -/
theorem dense_eventual_of_lengthGroup [Nonempty α] {T U : S.Hull}
    (hlen : ∀ a, S.ℓ a ∈ coincidenceShifts hd T) {a : α} {x y : ℝ}
    (hx : (a, x) ∈ T.1) (hy : (a, y) ∈ U.1) (h : x - y ∈ lengthGroup S) :
    Dense (eventual S T.1 U.1) := by
  have hle : lengthGroup S ≤ coincidenceShifts hd T :=
    (AddSubgroup.closure_le _).mpr (by rintro _ ⟨b, rfl⟩; exact hlen b)
  exact dense_eventual_of_shift_mem hd hx hy (hle h)

end Psc.PeriodicPartnerReturnModule
